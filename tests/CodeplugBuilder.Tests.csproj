<Project Sdk="Microsoft.NET.Sdk">
  <!-- Runs the Core engine tests on Linux/.NET 8. The Windows app compiles the same Core sources. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>disable</Nullable>
    <LangVersion>latest</LangVersion>
    <RootNamespace>CodeplugBuilder.Tests</RootNamespace>
    <ImplicitUsings>disable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="..\src\Core\**\*.cs" Link="Core\%(RecursiveDir)%(Filename)%(Extension)" />
    <EmbeddedResource Include="..\src\Core\Templates\*.CSV" LogicalName="CodeplugBuilder.Templates.%(Filename)%(Extension)" />
    <EmbeddedResource Include="..\src\Core\Geo\atlas.gz" LogicalName="CodeplugBuilder.Geo.atlas.gz" />
    <EmbeddedResource Include="..\src\Core\Geo\roads.gz" LogicalName="CodeplugBuilder.Geo.roads.gz" />
  </ItemGroup>
</Project>
